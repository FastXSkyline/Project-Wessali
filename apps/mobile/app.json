{
  "expo": {
    "name": "Wessali",
    "slug": "wessali",
    "version": "0.1.0",
    "scheme": "wessali",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "backgroundColor": "#F3F3EF",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "dz.wessali.app",
      "infoPlist": {
        "UIUserInterfaceStyle": "Light",
        "UIViewControllerBasedStatusBarAppearance": false
      },
      "deploymentTarget": "18.0"
    },
    "android": {
      "package": "dz.wessali.app",
      "edgeToEdgeEnabled": true,
      "adaptiveIcon": {
        "backgroundColor": "#F3F3EF"
      }
    },
    "androidStatusBar": {
      "backgroundColor": "#F3F3EF",
      "barStyle": "dark-content",
      "translucent": true
    },
    "androidNavigationBar": {
      "backgroundColor": "#F3F3EF",
      "barStyle": "dark-content"
    },
    "extra": {
      "eas": {
        "projectId": "8018b4b1-4662-4bc6-8140-a1a43cc5f55f"
      }
    },
    "plugins": [
      "expo-status-bar",
      "expo-font",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#F3F3EF",
          "resizeMode": "contain"
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Wessali uses your location to place accurate pickup and delivery pins.",
          "locationFullAccuracyPermission": "Wessali uses your precise location to put the pickup and delivery pin at the correct place."
        }
      ],
      [
        "expo-maps",
        {
          "requestLocationPermission": true,
          "locationPermission": "Wessali uses your location to place accurate pickup and delivery pins."
        }
      ]
    ]
  }
}
