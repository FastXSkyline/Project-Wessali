{
  "name": "@wessali/mobile",
  "version": "0.1.0",
  "private": true,
  "main": "expo/AppEntry",
  "scripts": {
    "dev": "expo start",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "build": "expo export --platform android --output-dir dist/android && expo export --platform ios --output-dir dist/ios",
    "typecheck": "tsc --noEmit",
    "lint": "prettier --check \"App.tsx\" \"app.json\" \"tsconfig.json\"",
    "postinstall": "pnpm -C ../.. --filter @wessali/contracts build && pnpm -C ../.. --filter @wessali/design-tokens build && pnpm -C ../.. --filter @wessali/i18n build"
  },
  "dependencies": {
    "@wessali/contracts": "workspace:*",
    "@wessali/design-tokens": "workspace:*",
    "@wessali/i18n": "workspace:*",
    "expo": "58.0.23",
    "react": "19.3.1",
    "react-native": "0.88.1",
    "expo-blur": "~58.0.5",
    "expo-linear-gradient": "~58.0.3",
    "expo-image": "58.0.18",
    "@expo-google-fonts/ibm-plex-sans-arabic": "^0.4.2",
    "@expo-google-fonts/sora": "^0.4.2",
    "@expo/metro-runtime": "~58.0.17",
    "@expo/vector-icons": "^15.1.1",
    "expo-font": "~58.0.11",
    "expo-haptics": "~58.0.7",
    "expo-splash-screen": "~58.0.13",
    "expo-status-bar": "~58.0.4",
    "react-dom": "19.3.0",
    "react-native-safe-area-context": "~5.11.1",
    "react-native-svg": "15.16.0",
    "react-native-web": "^0.21.4",
    "expo-location": "~58.0.20",
    "expo-maps": "~58.0.11"
  },
  "devDependencies": {
    "@types/react": "^19.0.0"
  },
  "optionalDependencies": {},
  "peerDependencies": {}
}
