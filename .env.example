NODE_ENV=development
PORT=4000
CORS_ORIGIN=http://localhost:3000,http://localhost:8081
DATABASE_URL=postgresql://wessali:wessali_dev_only@localhost:5432/wessali
REDIS_URL=redis://localhost:6379

# Development-only demo sign-in. Never enable this in production.
ALLOW_DEV_AUTH=true
ADMIN_DEMO_USERNAME=fastx
ADMIN_DEMO_KEY=fastx

NEXT_PUBLIC_API_BASE_URL=https://wessali-platform.anesteb8.workers.dev/v1
EXPO_PUBLIC_API_BASE_URL=https://wessali-platform.anesteb8.workers.dev/v1
NEXT_PUBLIC_WESSALI_ADMIN_URL=https://wessali-platform.anesteb8.workers.dev/admin

# Cloudflare production uses the D1 database and private R2 bucket configured on the Worker.
# Configure real local credentials only in local environments or deployment secret stores.
OBJECT_STORAGE_ENDPOINT=
OBJECT_STORAGE_BUCKET=wessali-local
OBJECT_STORAGE_ACCESS_KEY=
OBJECT_STORAGE_SECRET_KEY=
SMS_PROVIDER=
SMS_API_KEY=
